# 复制到 .ppt-agent/.env（推荐）
# 见：python -m src.main --init-workspace

# LLM（默认 DeepSeek，与 mini-harness-ts 一致）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# OfficeCLI（P0 安装路径）
OFFICECLI_BIN=/home/stt/.local/bin/officecli

# 可选：覆盖输出目录或工作区根（默认 .ppt-agent/output）
# PPT_OUTPUT_DIR=.ppt-agent/output
# PPT_AGENT_HOME=/abs/path/.ppt-agent

# 可选：LangSmith
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=

# LangGraph 图步数上限（默认 9999；多页 PPT 勿用 25）
# PPT_RECURSION_LIMIT=9999
